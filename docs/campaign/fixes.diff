+        _ => {
+            let mut imzml = out.as_os_str().to_owned();
+            imzml.push(".imzML");
+            let mut ibd = out.as_os_str().to_owned();
+            ibd.push(".ibd");
+            (PathBuf::from(imzml), PathBuf::from(ibd))
+        }
     }
 }
 
