<?xml version="1.0" encoding="UTF-8"?>
<!--
  Canonical fixture for the PROFILE-intensity dtype pinning tests (debug session
  profile-intensity-dtype): TWO profile spectra (MS:1000128), 5 points each, with the
  INTENSITY array encoded as 64-bit float (MS:1000523) and the m/z array as 64-bit float
  (MS:1000523). It is byte-for-byte identical to profile_intensity_f32.mzML EXCEPT for the
  two intensity binaryDataArray blocks (dtype cvParam MS:1000523 vs MS:1000521, encodedLength,
  and the base64 payload). The data VALUES are identical between the two fixtures; only the
  on-the-wire width differs.

  Purpose: prove the plain-mzML profile/chunked write path PRESERVES the source intensity
  width — a 64-bit-float source intensity must produce a mzPeak `chunk.intensity.list.item`
  column whose Parquet PHYSICAL TYPE is DOUBLE (f64). See tests/profile_intensity_dtype.rs.
-->
<indexedmzML xmlns="http://psi.hupo.org/ms/mzml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://psi.hupo.org/ms/mzml http://psidev.info/files/ms/mzML/xsd/mzML1.1.0_idx.xsd">
  <mzML xmlns="http://psi.hupo.org/ms/mzml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://psi.hupo.org/ms/mzml http://psidev.info/files/ms/mzML/xsd/mzML1.1.0.xsd" id="profile_intensity_f64" version="1.1.0">
    <cvList count="2">
      <cv id="MS" fullName="Proteomics Standards Initiative Mass Spectrometry Ontology" version="4.1.0" URI="https://raw.githubusercontent.com/HUPO-PSI/psi-ms-CV/master/psi-ms.obo"/>
      <cv id="UO" fullName="Unit Ontology" version="releases/2020-03-10" URI="http://purl.obolibrary.org/obo/uo.owl"/>
    </cvList>
    <fileDescription>
      <fileContent>
        <cvParam cvRef="MS" accession="MS:1000579" name="MS1 spectrum" value=""/>
        <cvParam cvRef="MS" accession="MS:1000128" name="profile spectrum" value=""/>
      </fileContent>
    </fileDescription>
    <softwareList count="1">
      <software id="mzml2mzpeak_fixture" version="1.0">
        <cvParam cvRef="MS" accession="MS:1000799" name="custom unreleased software tool" value="mzml2mzpeak test fixture"/>
      </software>
    </softwareList>
    <instrumentConfigurationList count="1">
      <instrumentConfiguration id="IC1">
        <cvParam cvRef="MS" accession="MS:1000031" name="instrument model" value=""/>
      </instrumentConfiguration>
    </instrumentConfigurationList>
    <dataProcessingList count="1">
      <dataProcessing id="fixture_processing">
        <processingMethod order="0" softwareRef="mzml2mzpeak_fixture">
          <cvParam cvRef="MS" accession="MS:1000544" name="Conversion to mzML" value=""/>
        </processingMethod>
      </dataProcessing>
    </dataProcessingList>
    <run id="profile_intensity_f64_run" defaultInstrumentConfigurationRef="IC1">
      <spectrumList count="2" defaultDataProcessingRef="fixture_processing">
        <spectrum index="0" id="scan=1" defaultArrayLength="5">
          <cvParam cvRef="MS" accession="MS:1000511" name="ms level" value="1"/>
          <cvParam cvRef="MS" accession="MS:1000579" name="MS1 spectrum" value=""/>
          <cvParam cvRef="MS" accession="MS:1000128" name="profile spectrum" value=""/>
          <scanList count="1">
            <cvParam cvRef="MS" accession="MS:1000795" name="no combination" value=""/>
            <scan>
              <cvParam cvRef="MS" accession="MS:1000016" name="scan start time" value="0.1" unitCvRef="UO" unitAccession="UO:0000031" unitName="minute"/>
            </scan>
          </scanList>
          <binaryDataArrayList count="2">
            <binaryDataArray encodedLength="56">
              <cvParam cvRef="MS" accession="MS:1000523" name="64-bit float" value=""/>
              <cvParam cvRef="MS" accession="MS:1000576" name="no compression" value=""/>
              <cvParam cvRef="MS" accession="MS:1000514" name="m/z array" value="" unitCvRef="MS" unitAccession="MS:1000040" unitName="m/z"/>
              <binary>AAAAAAAAWUAAAAAAABBZQAAAAAAAIFlAAAAAAAAwWUAAAAAAAEBZQA==</binary>
            </binaryDataArray>
            <binaryDataArray encodedLength="56">
              <cvParam cvRef="MS" accession="MS:1000523" name="64-bit float" value=""/>
              <cvParam cvRef="MS" accession="MS:1000576" name="no compression" value=""/>
              <cvParam cvRef="MS" accession="MS:1000515" name="intensity array" value="" unitCvRef="MS" unitAccession="MS:1000131" unitName="number of counts"/>
              <binary>AAAAAAAAJEAAAAAAAIA0QAAAAAAAoEtAAAAAAAAAMkAAAAAAAAASQA==</binary>
            </binaryDataArray>
          </binaryDataArrayList>
        </spectrum>
        <spectrum index="1" id="scan=2" defaultArrayLength="5">
          <cvParam cvRef="MS" accession="MS:1000511" name="ms level" value="1"/>
          <cvParam cvRef="MS" accession="MS:1000579" name="MS1 spectrum" value=""/>
          <cvParam cvRef="MS" accession="MS:1000128" name="profile spectrum" value=""/>
          <scanList count="1">
            <cvParam cvRef="MS" accession="MS:1000795" name="no combination" value=""/>
            <scan>
              <cvParam cvRef="MS" accession="MS:1000016" name="scan start time" value="0.2" unitCvRef="UO" unitAccession="UO:0000031" unitName="minute"/>
            </scan>
          </scanList>
          <binaryDataArrayList count="2">
            <binaryDataArray encodedLength="56">
              <cvParam cvRef="MS" accession="MS:1000523" name="64-bit float" value=""/>
              <cvParam cvRef="MS" accession="MS:1000576" name="no compression" value=""/>
              <cvParam cvRef="MS" accession="MS:1000514" name="m/z array" value="" unitCvRef="MS" unitAccession="MS:1000040" unitName="m/z"/>
              <binary>AAAAAAAAaUAAAAAAAAhpQAAAAAAAEGlAAAAAAAAYaUAAAAAAACBpQA==</binary>
            </binaryDataArray>
            <binaryDataArray encodedLength="56">
              <cvParam cvRef="MS" accession="MS:1000523" name="64-bit float" value=""/>
              <cvParam cvRef="MS" accession="MS:1000576" name="no compression" value=""/>
              <cvParam cvRef="MS" accession="MS:1000515" name="intensity array" value="" unitCvRef="MS" unitAccession="MS:1000131" unitName="number of counts"/>
              <binary>AAAAAAAACEAAAAAAAAAiQAAAAAAAAEVAAAAAAAAAHkAAAAAAAAD0Pw==</binary>
            </binaryDataArray>
          </binaryDataArrayList>
        </spectrum>
      </spectrumList>
    </run>
  </mzML>
</indexedmzML>
